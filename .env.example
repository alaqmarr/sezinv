# Local SQLite database path (WAL concurrency enabled automatically)
DATABASE_URL="file:./data/jamatevents.db"

# Read-only Neon PostgreSQL URL used ONLY for the One-Click Migration tool (optional)
NEON_DATABASE_URL=""

# Signing secrets for user login sessions and Email verification amount unlock
AUTH_SECRET="replace-with-strong-random-secret"
AMOUNT_OTP_SECRET="replace-with-strong-random-secret"

# Shared internal API bridge key & loopback URL for companion SEZSEC member portal (:3334)
SEZSEC_BRIDGE_KEY="replace-with-strong-shared-bridge-key"
SEZSEC_INTERNAL_URL="http://127.0.0.1:3334"
PORT="3333"

# Fallback outgoing Gmail credentials (can be managed directly from Office Settings -> Email & Backups)
SMTP_EMAIL="info@sezsec.org"
SMTP_PASSWORD="replace-with-gmail-app-password"

# Portal base URL used in email links and shareable passes
NEXT_PUBLIC_APP_URL="http://localhost:3000"
